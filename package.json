{
  "name": "tier-one-bio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && vite build && node scripts/prerender.js && node scripts/check-bundle-secrets.js && node scripts/check-site-integrity.js",
    "check:secrets": "node scripts/check-bundle-secrets.js",
    "check:site": "node scripts/check-site-integrity.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "smoke": "node scripts/smoke-render.mjs",
    "verify": "npm run lint && npm test && npm run smoke && npm run build",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.1"
  }
}
